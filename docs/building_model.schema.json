    "CoordinateFrame": {
      "description": "A named coordinate frame and its affine transform to its parent frame.\n\n``matrix`` is a row-major 4x4 homogeneous matrix mapping a point in THIS\nframe's parent into this frame: p_this = M @ p_parent. ``None`` with\nstatus \"unresolved\" means the relationship is unknown (never assumed).",
      "properties": {
        "id": {
          "enum": [
            "SRC",
            "SRC_FT",
            "LOCAL",
            "PROJECT"
          ],
          "title": "Id",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "enum": [
                "SRC",
                "SRC_FT",
                "LOCAL",
                "PROJECT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        },
        "status": {
          "default": "defined",
          "enum": [
            "defined",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "matrix": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matrix"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "CoordinateFrame",
      "type": "object"
    },
